<Window x:Class="osm2mssql.Importer.Views.ConfirmReplaceDatabaseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReplaceDatabaseTitle}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="../Images/App.ico"
        Background="{StaticResource AppBackgroundBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <Grid Margin="20,20,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Height="32" VerticalAlignment="Top" Source="../Images/warning.png"
                       SnapsToDevicePixels="True"/>
                <TextBlock x:Name="WarningText" Grid.Column="2" TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                           LineHeight="18"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Replace}" MinWidth="100" Click="Replace_Click"
                    Style="{StaticResource DangerButton}"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" MinWidth="100" Margin="10,0,0,0"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
