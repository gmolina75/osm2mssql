<Window x:Class="osm2mssql.Importer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModel="clr-namespace:osm2mssql.Importer.ViewModel"
        xmlns:classes="clr-namespace:osm2mssql.Importer.Classes"
        Title="osm2mssql" Width="1020" Height="640" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="../Images/App.ico"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <ViewModel:ImporterViewModel x:Key="vm"/>
        <classes:LogLineBrushConverter x:Key="LogLineBrushConverter"/>

        <!-- Banner de resultado de conexión: creación vs. modo destructivo -->
        <Style x:Key="ConnectionBanner" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="Successful">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="DbAlreadyExists">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera de aplicación -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Height="34" Source="../Images/osm2mssql.png" SnapsToDevicePixels="True"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="osm2mssql" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FormLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="LanguageComboBox" Width="140"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding Model.Language, Mode=TwoWay}"
                              SelectionChanged="LanguageComboBox_SelectionChanged"
                              ToolTip="{DynamicResource ToolTipLanguage}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="210"/>
            </Grid.RowDefinitions>

            <!-- ===== Sección: conexión a la base de datos ===== -->
            <Border Grid.Row="0" Grid.RowSpan="1" Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{DynamicResource DatabaseConnectionSettings}"
                                   Style="{StaticResource SectionHeader}"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Host}" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox Text="{Binding Model.Host, Mode=TwoWay}"
                                         ToolTip="{DynamicResource ToolTipHost}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Database}" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox Text="{Binding Model.Database, Mode=TwoWay}"
                                         TextChanged="DatabaseName_TextChanged"
                                         ToolTip="{DynamicResource ToolTipDatabase}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Username}" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox Text="{Binding Model.Username, Mode=TwoWay}"
                                         ToolTip="{DynamicResource ToolTipUsername}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Password}" Style="{StaticResource FormLabel}"/>
                            <Border Style="{StaticResource InputChrome}">
                                <TextBox Text="{Binding Model.Password, Mode=TwoWay}"
                                         ToolTip="{DynamicResource ToolTipPassword}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FormLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      DisplayMemberPath="Value" SelectedValuePath="Key"
                                      SelectedValue="{Binding Model.Language, Mode=TwoWay}"
                                      ToolTip="{DynamicResource ToolTipLanguage}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Height="16" Width="16" Margin="0,0,8,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="../Images/ok.png"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="Unknown">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="Successful">
                                                <Setter Property="Source" Value="../Images/ok.png"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="Error">
                                                <Setter Property="Source" Value="../Images/error.png"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="DbAlreadyExists">
                                                <Setter Property="Source" Value="../Images/warning.png"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Button Command="{Binding TryToConnect}" Content="{DynamicResource TryToConnect}"
                                    Click="Button_Click" MinWidth="150"
                                    ToolTip="{DynamicResource ToolTipTryToConnect}"/>
                        </StackPanel>

                        <Border Grid.Row="7" Style="{StaticResource ConnectionBanner}">
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="Successful">
                                                <Setter Property="Text" Value="{DynamicResource DatabaseWillBeCreated}"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastTryConnectionResult}" Value="DbAlreadyExists">
                                                <Setter Property="Text" Value="{DynamicResource DatabaseWillBeReplaced}"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ===== Sección: tareas de importación ===== -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource Import}" Style="{StaticResource SectionHeader}"/>

                    <Grid Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter HorizontalAlignment="Stretch"/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Padding="10,0,0,0">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Height="16" Width="16">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="Pending">
                                                                <Setter Property="Source" Value="../Images/arrowright.png"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="InProgress">
                                                                <Setter Property="Source" Value="../Images/refresh.png"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Error">
                                                                <Setter Property="Source" Value="../Images/error.png"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="Successful">
                                                                <Setter Property="Source" Value="../Images/ok.png"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AdditionalInfos}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                            <ProgressBar Grid.Column="5" VerticalAlignment="Center" IsIndeterminate="True">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="InProgress">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="7" Text="{Binding Duration,StringFormat=hh\\:mm\\:ss}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                       FontFamily="{StaticResource UiMonoFontFamily}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="Pending">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Image Source="../Images/osm.png" Opacity="0.06" Stretch="Uniform"
                               Margin="24" IsHitTestVisible="False"/>
                    </Grid>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                            IsEnabled="{Binding IsNotProcessing}" Command="{Binding StartImport}"
                            Content="{DynamicResource StartImport}"
                            ToolTip="{DynamicResource ToolTipStartImport}"/>
                </Grid>
            </Border>

            <!-- ===== Sección: registro (log) ===== -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource LogPanelTitle}"
                               Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Style="{StaticResource InputChrome}" SnapsToDevicePixels="True">
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogRows}"
                                 Background="Transparent"
                                 FontFamily="{StaticResource UiMonoFontFamily}"
                                 FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="NoWrap"
                                               Foreground="{Binding Converter={StaticResource LogLineBrushConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
