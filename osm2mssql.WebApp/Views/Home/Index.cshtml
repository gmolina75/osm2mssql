@{
    ViewBag.Title = "Mapa OSM";
}
@model osm2mssql.WebApp.Models.ReverseGeocodingModel
<link rel="stylesheet" href="@Url.Content("~/Content/openlayers/ol.css")" />
<style>
    html, body { height: 100%; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
    #layout { display: flex; height: 100%; }
    #panel {
        width: 340px; min-width: 340px; padding: 12px; box-sizing: border-box;
        background: #f5f5f5; border-right: 1px solid #ccc; overflow-y: auto;
    }
    #panel h2 { margin: 0 0 12px 0; font-size: 20px; }
    #panel label { display: block; margin: 8px 0 4px 0; font-weight: 600; }
    #panel select, #panel input[type=text] { width: 100%; box-sizing: border-box; padding: 6px; }
    #panel button { margin-top: 8px; padding: 6px 12px; cursor: pointer; }
    #resultados { list-style: none; margin: 12px 0 0 0; padding: 0; }
    #resultados li {
        padding: 8px; margin-bottom: 6px; background: #fff; border: 1px solid #ddd;
        border-radius: 4px; cursor: pointer;
    }
    #resultados li:hover { background: #e8f0e8; }
    #resultados .nombre { font-weight: 600; }
    #resultados .coords { color: #666; font-size: 12px; }
    #mensaje { margin-top: 10px; color: #a00; }
    #mensaje.info { color: #060; }
    #aviso-bd {
        padding: 10px; margin-bottom: 12px; background: #f2dede; color: #a94442;
        border: 1px solid #ebccd1; border-radius: 4px; font-size: 14px;
    }
    #mapa { flex: 1; height: 100%; }
    #popup {
        display: none; background: #fff; border: 1px solid #999; border-radius: 4px;
        padding: 8px 10px; font-size: 13px; max-width: 260px;
        box-shadow: 0 1px 4px rgba(0,0,0,.3);
    }
</style>

<div id="layout">
    @{ var errorBd = ViewBag.ErrorMessage as string; }
    <div id="panel">
        <h2>osm2mssql &mdash; Demo de mapa</h2>

        @if (!string.IsNullOrEmpty(errorBd))
        {
            <div id="aviso-bd">@errorBd</div>
        }

        <label for="tagType">Tipo de elemento</label>
        @Html.DropDownListFor(x => x.SelectedTagTyp, new SelectList(Model.TagTypes, "Typ", "Name", Model.SelectedTagTyp), "— Selecciona un tipo —", new { id = "tagType", disabled = string.IsNullOrEmpty(errorBd) ? null : "disabled" })

        <label for="texto">Buscar</label>
        <input type="text" id="texto" placeholder="Nombre a buscar..." @(string.IsNullOrEmpty(errorBd) ? "" : "disabled=\"disabled\"") />

        <button id="buscar" type="button" @(string.IsNullOrEmpty(errorBd) ? "" : "disabled=\"disabled\"")>Buscar</button>
        <div id="mensaje"></div>

        <ul id="resultados"></ul>
    </div>
    <div id="mapa"></div>
    <div id="popup"></div>
</div>

@section scripts{
    <script src="@Url.Content("~/Scripts/openlayers/ol.js")"></script>
    <script>
        $(function () {
            var vista = new ol.View({
                center: ol.proj.fromLonLat([-78.47, -0.18]), // Ecuador aprox.
                zoom: 8
            });
            var mapa = new ol.Map({
                target: 'mapa',
                layers: [new ol.layer.Tile({ source: new ol.source.OSM() })],
                view: vista
            });

            var fuenteMarcadores = new ol.source.Vector();
            mapa.addLayer(new ol.layer.Vector({ source: fuenteMarcadores }));

            var marcadorBusqueda = null;
            var marcadorInverso = null;
            var $mensaje = $('#mensaje');
            var $resultados = $('#resultados');

            var popupOverlay = new ol.Overlay({
                element: document.getElementById('popup'),
                positioning: 'bottom-center',
                offset: [0, -12],
                stopEvent: true
            });
            mapa.addOverlay(popupOverlay);

            function mostrarPopup(coordenada, html) {
                document.getElementById('popup').innerHTML = html;
                document.getElementById('popup').style.display = 'block';
                popupOverlay.setPosition(coordenada);
            }

            function ocultarPopup() {
                popupOverlay.setPosition(undefined);
                document.getElementById('popup').style.display = 'none';
            }

            function crearEstilo(borde, relleno) {
                return new ol.style.Style({
                    image: new ol.style.Circle({
                        radius: 8,
                        fill: new ol.style.Fill({ color: relleno }),
                        stroke: new ol.style.Stroke({ color: borde, width: 2 })
                    })
                });
            }
            var estiloBusqueda = crearEstilo('#d33', 'rgba(255, 102, 102, 0.7)');
            var estiloInverso = crearEstilo('#36c', 'rgba(102, 153, 255, 0.7)');

            function mostrarMensaje(texto, esInfo) {
                $mensaje.text(texto || '');
                $mensaje.toggleClass('info', !!esInfo);
            }

            function mostrarErrorAjax(xhr, mensajeGenerico) {
                var mensaje = mensajeGenerico;
                if (xhr && xhr.responseJSON && xhr.responseJSON.error) {
                    mensaje = xhr.responseJSON.error;
                }
                mostrarMensaje(mensaje);
            }

            function mostrarResultadoEnMapa(lat, lon, titulo) {
                var coordenada = ol.proj.fromLonLat([lon, lat]);
                if (marcadorBusqueda) {
                    fuenteMarcadores.removeFeature(marcadorBusqueda);
                }
                marcadorBusqueda = new ol.Feature({ geometry: new ol.geom.Point(coordenada) });
                marcadorBusqueda.setStyle(estiloBusqueda);
                fuenteMarcadores.addFeature(marcadorBusqueda);
                mostrarPopup(coordenada, '<b>' + titulo + '</b><br>' + formatearCoordenadas(lat, lon));
                vista.animate({ center: coordenada, zoom: 16, duration: 1000 });
            }

            function formatearCoordenadas(lat, lon) {
                return 'Lat: ' + lat.toFixed(6) + ', Lon: ' + lon.toFixed(6);
            }

            $('#buscar').on('click', function () {
                var tagType = $('#tagType').val();
                var texto = $.trim($('#texto').val());
                $resultados.empty();
                mostrarMensaje('');

                if (!texto) {
                    mostrarMensaje('Escribe un texto para buscar.');
                    return;
                }

                if (!tagType) {
                    mostrarMensaje('Selecciona un tipo de elemento para buscar.');
                    return;
                }

                $.getJSON('api/ReverseGeocoding/search', { tagType: tagType, text: texto })
                    .done(function (resultados) {
                        if (!resultados || resultados.length === 0) {
                            mostrarMensaje('Sin resultados para la búsqueda.');
                            return;
                        }
                        $.each(resultados, function (i, r) {
                            $('<li>')
                                .append($('<div>').addClass('nombre').text(r.name))
                                .append($('<div>').addClass('coords').text(formatearCoordenadas(r.lat, r.lon)))
                                .on('click', function () {
                                    mostrarResultadoEnMapa(r.lat, r.lon, r.name);
                                })
                                .appendTo($resultados);
                        });
                        mostrarMensaje(resultados.length + ' resultado(s).', true);
                    })
                    .fail(function (xhr) {
                        mostrarErrorAjax(xhr, 'Error al consultar el servidor.');
                    });
            });

            $('#texto').on('keypress', function (e) {
                if (e.which === 13) {
                    $('#buscar').click();
                }
            });

            mapa.on('click', function (evt) {
                var lonlat = ol.proj.toLonLat(evt.coordinate);
                var lon = lonlat[0];
                var lat = lonlat[1];
                mostrarMensaje('Consultando ubicación...', true);

                $.getJSON('api/ReverseGeocoding/reverse', { lat: lat, lon: lon })
                    .done(function (info) {
                        mostrarMensaje('');
                        if (marcadorInverso) {
                            fuenteMarcadores.removeFeature(marcadorInverso);
                        }
                        marcadorInverso = new ol.Feature({ geometry: new ol.geom.Point(evt.coordinate) });
                        marcadorInverso.setStyle(estiloInverso);
                        fuenteMarcadores.addFeature(marcadorInverso);

                        var lineas = [formatearCoordenadas(lat, lon)];
                        if (info && info.name) {
                            lineas.push(info.name + (info.place ? ' (' + info.place + ')' : ''));
                            lineas.push('Nivel administrativo: ' + info.adminLevel);
                            if (info.postalCode) {
                                lineas.push('Código postal: ' + info.postalCode);
                            }
                        } else {
                            lineas.push('Sin información administrativa para este punto.');
                        }
                        mostrarPopup(evt.coordinate, lineas.join('<br>'));
                    })
                    .fail(function (xhr) {
                        ocultarPopup();
                        mostrarErrorAjax(xhr, 'Error al consultar la geocodificación inversa.');
                    });
            });
        });
    </script>
}
